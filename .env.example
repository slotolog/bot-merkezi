# Yönetici botun token'ı (BotFather'dan)
ADMIN_BOT_TOKEN=123456:ABC...
# Yönetici botu kullanabilecek Telegram kullanıcı ID'leri (virgülle)
ADMIN_IDS=111111111
# Medya depo kanalının ID'si (-100 ile başlar). Bilmiyorsan boş bırak, kurulumda /id ile öğren.
STORAGE_CHAT_ID=
# Postgres şifresi (docker-compose kullanır)
POSTGRES_PASSWORD=degistir_bunu
DATABASE_URL=postgresql+asyncpg://botmerkezi:degistir_bunu@db:5432/botmerkezi
# Saniyede bot başına gönderilecek mesaj (Telegram sınırı ~30)
SEND_RATE=25
TZ_NAME=Europe/Istanbul
# Buton tıklama takibi için yönlendirme adresi (örn. https://t.senindomainin.com). Boşsa takip kapalı.
PUBLIC_URL=
WEB_PORT=8080
# Takip linklerini imzalamak için gizli anahtar (rastgele uzun bir yazı)
TRACK_SECRET=
